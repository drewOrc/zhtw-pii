# zhtw-pii runtime configuration. Copy to .env and fill in as needed.

# Random seed for deterministic data generation, training, and evaluation.
ZHTW_PII_SEED=42

# Root directory for generated datasets, results, and exported models.
ZHTW_PII_DATA_DIR=data

# Anthropic API key. Only used from M1 onward, by the LLM baseline in
# zhtw_pii/eval/benchmark.py. Not read by any Day 0 code. Leave blank until M1.
ANTHROPIC_API_KEY=
